# Set values only in Vercel's private server-side environment settings.
SHUTTLE_ORIGIN=https://YOUR-PROJECT.vercel.app
# Supabase > Connect > Transaction pooler. Preserve certificate verification.
DATABASE_URL=
DATABASE_CA_CERT=
CRON_SECRET=
SHUTTLE_SETUP_TOKEN=
SHUTTLE_OWNER_EMAIL=info@rugtomize.co
# Canonical shop hostname, no scheme or path.
SHOPIFY_STORE=47d43a.myshopify.com
# Merchant-owned app in the SAME Shopify organization:
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Alternative: existing valid Admin API token. Never a storefront token.
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_TAG_SYNC=0
SHUTTLE_STATION_TOKEN=
SHUTTLE_WORKFLOW_TOKEN=
PARSEL_TOKEN=
PARSEL_BASE_URL=https://api.parsel.app
PARSEL_LABEL_HOSTS=

# Read-only Drive access to production folders and private thumbnails.
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REFRESH_TOKEN=

# Enable only after authorizing Drive file move/rename permission.
GDRIVE_WRITE_ENABLED=0

# Optional. Default 0: no Parsel initialization, credentials or requests.
PARSEL_ENABLED=0

# Supabase Auth (project URL + publishable key, not a service-role key).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# oauth for apps owned by a different organization; client_credentials otherwise.
SHOPIFY_AUTH_MODE=oauth
SHOPIFY_SCOPES=read_orders
# Private base64-encoded 32-byte key. Keep stable to decrypt saved OAuth tokens.
SHOPIFY_TOKEN_ENCRYPTION_KEY=

# app: subscriptions created for this Shopify app; verify with SHOPIFY_CLIENT_SECRET.
# manual: subscriptions created in Shopify Admin Notifications; use SHOPIFY_WEBHOOK_SECRET.
SHOPIFY_WEBHOOK_SOURCE=app
