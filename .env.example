# Set values only in Vercel's private server-side environment settings.
SHUTTLE_ORIGIN=https://YOUR-PROJECT.vercel.app
# Supabase > Connect > Transaction pooler. Preserve certificate verification.
DATABASE_URL=
CRON_SECRET=
SHUTTLE_SETUP_TOKEN=
SHUTTLE_OWNER_EMAIL=info@rugtomize.co
# Canonical shop hostname, no scheme or path.
SHOPIFY_STORE=47d43a.myshopify.com
# Merchant-owned app in the SAME Shopify organization:
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Alternative: existing valid Admin API token. Never a storefront token.
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_TAG_SYNC=0
SHUTTLE_STATION_TOKEN=
SHUTTLE_WORKFLOW_TOKEN=
PARSEL_TOKEN=
PARSEL_BASE_URL=https://api.parsel.app
PARSEL_LABEL_HOSTS=
